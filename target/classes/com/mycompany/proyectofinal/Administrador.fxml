<?xml version="1.0" encoding="UTF-8"?>

<!-- Administrador.fxml -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelPrincipal" prefHeight="600.0" prefWidth="900.0" stylesheets="@Administrador.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyectofinal.Controllers.AdministradorController">
    
    <left>
        <VBox id="sidePanel" prefWidth="220.0">
            <VBox id="logoContainer" alignment="CENTER" spacing="10.0">
                <ImageView fitHeight="95.0" fitWidth="119.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../RECURSOS/dinomuseo.PNG" />
                    </image>
                </ImageView>
                <Label id="panelTitle" text="Administradores" />
            </VBox>
            
            <VBox id="buttonContainer" alignment="TOP_CENTER" spacing="8.0">
                <Button id="navButton" fx:id="BtnUsarios" mnemonicParsing="false" onAction="#manejarUsuarios" prefHeight="40.0" prefWidth="180.0" text="Usuarios" />
                <Button id="navButton" fx:id="btnSalas" mnemonicParsing="false" onAction="#manejarSala1" prefHeight="40.0" prefWidth="180.0" text="Sala " />
                <Button id="navButton" mnemonicParsing="false" text="Salir" visible="false" />
                <Button id="navButton" mnemonicParsing="false" onAction="#volverLogin" text="Volver a Inicio de Sesión" />
                <Button id="navButton" mnemonicParsing="false" onAction="#manejarSalir" text="Salir" />
            </VBox>
        </VBox>
    </left>
    
    <center>
        <VBox BorderPane.alignment="CENTER">
            <HBox id="adminHeader" alignment="CENTER_LEFT">
                <Label id="adminTitle" fx:id="etiquetaTitulo" text="Panel de Administración" />
            </HBox>
            
            <StackPane id="contentArea" fx:id="areaContenido" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
</BorderPane>
