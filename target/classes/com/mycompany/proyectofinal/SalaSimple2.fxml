<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="800.0" styleClass="mainFxmlClass" stylesheets="salasimple2.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyectofinal.Controllers.SalaSimple2Controller">
    
    
   <ImageView fitHeight="567.0" fitWidth="800.0" layoutY="33.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../../../RECURSOS/FONDONEGRO.png" />
      </image>
      <viewport>
         <Rectangle2D height="800.0" minX="1.0" minY="1.0" width="1200.0" />
      </viewport></ImageView>
    
    <VBox fx:id="contentBox" spacing="20" AnchorPane.bottomAnchor="50" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.topAnchor="50">
        
        <!-- Sección 1 -->
        <AnchorPane styleClass="section">
            <Label layoutX="199.2" prefHeight="18.0" prefWidth="500.0" styleClass="section-text" text="Mona Lisa" textFill="#f4f4f4" wrapText="true" AnchorPane.leftAnchor="199.0" AnchorPane.rightAnchor="0" />
         <Label layoutX="210.0" layoutY="34.0" prefHeight="93.0" prefWidth="303.0" styleClass="section-text" text="Pintada entre 1503 y 1506, la Mona Lisa es una obra maestra del Renacimiento italiano. Destaca por la misteriosa sonrisa de la modelo y el uso del sfumato. Se exhibe en el Museo del Louvre, París, y es considerada el retrato más famoso del mundo." textFill="WHITE" wrapText="true" />
         <ImageView fitHeight="185.0" fitWidth="200.0" layoutX="-22.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true" styleClass="section-image">
            <image>
               <Image url="@../../../RECURSOS/MONALISA.png" />
            </image>
         </ImageView>
         <Button fx:id="Minfo" layoutX="554.0" layoutY="79.0" mnemonicParsing="false" onAction="#irSala1" text="Más Información" />
        </AnchorPane>
        
        <!-- Sección 2 -->
        <AnchorPane styleClass="section">
            <ImageView fitHeight="133.0" fitWidth="200.0" layoutX="-21.0" layoutY="12.0" pickOnBounds="true" preserveRatio="true" styleClass="section-image">
            <image>
               <Image url="@../../../RECURSOS/NocheEstrellada.png" />
            </image></ImageView>
            <Label layoutX="199.2" prefHeight="18.0" prefWidth="500.0" styleClass="section-text" text="La Noche Estrellada" textFill="WHITE" wrapText="true" AnchorPane.leftAnchor="199.0" AnchorPane.rightAnchor="0.0" />
         <Label layoutX="198.0" layoutY="42.0" prefHeight="94.0" prefWidth="303.0" styleClass="section-text" text="Realizada en 1889, muestra una vista nocturna desde la habitación del artista en Saint-Rémy-de-Provence. Con pinceladas ondulantes y colores vibrantes, refleja la intensidad emocional de Van Gogh. Es una de las obras más reconocidas del postimpresionismo y se exhibe en el Museo de Arte Moderno, Nueva York." textFill="#fff7f7" wrapText="true" />
         <Button layoutX="554.0" layoutY="68.0" mnemonicParsing="false" onAction="#irSala1" prefHeight="26.0" prefWidth="106.0" text="Más Información" />
        </AnchorPane>
        
        <!-- Sección 3 -->
        <AnchorPane styleClass="section">
            <ImageView fitHeight="137.0" fitWidth="200.0" layoutX="-23.0" layoutY="8.0" pickOnBounds="true" preserveRatio="true" styleClass="section-image">
            <image>
               <Image url="@../../../RECURSOS/EL%20GRITO.png" />
            </image></ImageView>
            <Label layoutX="199.2" prefHeight="18.0" prefWidth="500.0" styleClass="section-text" text="El Grito" textFill="WHITE" wrapText="true" AnchorPane.leftAnchor="199.0" AnchorPane.rightAnchor="0" />
         <Label layoutX="198.0" layoutY="42.0" prefHeight="93.0" prefWidth="303.0" styleClass="section-text" text="Pintado en 1893, representa una figura angustiada sobre un fondo de cielo rojo ardiente. Expresa ansiedad y desesperación, convirtiéndose en un icono del arte expresionista. Existen varias versiones en pintura y litografía. Una de las más conocidas se encuentra en la Galería Nacional de Noruega." textFill="WHITE" wrapText="true" />
         <Button layoutX="556.0" layoutY="62.0" mnemonicParsing="false" onAction="#irSala1" text="Más información" />
        </AnchorPane>
        
    </VBox>
   <ButtonBar layoutX="577.0" layoutY="30.0" prefHeight="40.0" prefWidth="200.0">
     <buttons>
       <Button minWidth="55.0" mnemonicParsing="false" onAction="#volverALaVistaPrincipal" prefHeight="26.0" prefWidth="103.0" text="Atras" />
     </buttons>
   </ButtonBar>
</AnchorPane>
