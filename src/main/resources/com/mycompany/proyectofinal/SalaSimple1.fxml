<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="800.0" styleClass="mainFxmlClass" stylesheets="@salasimple1.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyectofinal.Controllers.SalaSimple1Controller">
    
          
   <ImageView fitHeight="548.0" fitWidth="800.0" layoutY="27.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../../../RECURSOS/FONDONEGRO.png" />
      </image>
   </ImageView>
    
    <VBox fx:id="contentBox" spacing="20" AnchorPane.bottomAnchor="50" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.topAnchor="50">
        
        <!-- Sección 1 -->
        <AnchorPane styleClass="section">
            <ImageView fitHeight="120.0" fitWidth="199.0" layoutX="43.0" layoutY="49.0" pickOnBounds="true" preserveRatio="true" styleClass="section-image">
            <image>
               <Image url="@../../../RECURSOS/DINOIMAGEN.png" />
            </image></ImageView>
            <Label layoutX="217.0" layoutY="24.0" prefHeight="18.0" prefWidth="493.0" styleClass="section-text" text="Tyrannosaurus rex" textFill="WHITE" wrapText="true" AnchorPane.leftAnchor="217.0" AnchorPane.rightAnchor="-10.600000000000023">
            <font>
               <Font name="Book Antiqua" size="14.0" />
            </font></Label>
         <Label layoutX="233.0" layoutY="23.0" prefHeight="171.0" prefWidth="342.0" styleClass="section-text" text="Tyrannosaurus rex fue un enorme depredador del Cretácico superior en Norteamérica, que vivió hace 68–66 millones de años. Tenía cráneo masivo, dientes serrados, brazos pequeños y cola larga para equilibrar. Fósiles muestran crecimiento rápido, heridas de combate y posible plumaje en etapas juveniles; pieza central en exhibiciones, museos y divulgación." textFill="WHITE" wrapText="true" />
         <Button fx:id="aja" layoutX="591.0" layoutY="85.0" mnemonicParsing="false" onAction="#irATyrannosaurus" prefHeight="26.0" prefWidth="110.0" text="Más información" />
        </AnchorPane>
        
        <!-- Sección 2 -->
        <AnchorPane styleClass="section">
         <Label layoutX="232.0" layoutY="19.0" prefHeight="138.0" prefWidth="360.0" styleClass="section-text" text="Triceratops fue un gran herbívoro del Cretácico superior en Norteamérica, presente hace 68–66 millones de años. Destacaba por su cráneo masivo con tres cuernos y un volante óseo; medía hasta nueve metros. Sus cuernos servían para defensa y disputas sociales. En museos, cráneos y réplicas ilustran su ecología y comportamiento." textFill="WHITE" wrapText="true" />
         <ImageView fitHeight="120.0" fitWidth="199.0" layoutX="41.0" layoutY="19.0" pickOnBounds="true" preserveRatio="true" styleClass="section-image">
            <image>
               <Image url="@../../../RECURSOS/triceratop.png" />
            </image>
         </ImageView>
         <Label layoutX="232.0" layoutY="12.0" prefHeight="18.0" prefWidth="493.0" styleClass="section-text" text="Triceratops" textFill="WHITE" wrapText="true">
            <font>
               <Font name="Book Antiqua" size="14.0" />
            </font>
         </Label>
         <Button fx:id="aja" layoutX="592.0" layoutY="61.0" mnemonicParsing="false" onAction="#irATriceratops" prefHeight="26.0" prefWidth="109.0" text="Más información" />
        </AnchorPane>
        
        <!-- Sección 3 -->
        <AnchorPane styleClass="section">
            <ImageView fitHeight="120.0" fitWidth="199.0" layoutX="41.0" layoutY="-10.0" pickOnBounds="true" preserveRatio="true" styleClass="section-image">
            <image>
               <Image url="@../../../RECURSOS/Velociraptor.png" />
            </image></ImageView>
            <Label layoutX="228.8" layoutY="-10.0" prefHeight="18.0" prefWidth="531.0" styleClass="section-text" text="Velociraptor" textFill="WHITE" wrapText="true" AnchorPane.leftAnchor="229.0" AnchorPane.rightAnchor="-34.0">
            <font>
               <Font name="Book Antiqua" size="14.0" />
            </font>
         </Label>
         <Label layoutX="229.0" layoutY="13.0" prefHeight="94.0" prefWidth="360.0" styleClass="section-text" text="Velociraptor fue un terópodo ágil del Cretácico tardío en Asia, que vivió hace 75–71 millones de años. Mucho más pequeño que en el cine, medía cerca de dos metros y probablemente tenía plumas. Tenía una garra en hoz en cada pata usada para atacar. Réplicas y modelos muestran su aspecto." textFill="WHITE" wrapText="true" />
         <Button fx:id="aja" layoutX="589.0" layoutY="42.0" mnemonicParsing="false" onAction="#irAVelociraptor" prefHeight="26.0" prefWidth="110.0" text="Más información" />
        </AnchorPane>
        
    </VBox>
 <Button layoutX="653.0" layoutY="37.0" mnemonicParsing="false" onAction="#atras" prefHeight="26.0" prefWidth="118.0" text="Atras" />
    
    
</AnchorPane>
