<?xml version="1.0" encoding="UTF-8"?>
<!-- Recuperar.fxml -->
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" 
            minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" 
            xmlns="http://javafx.com/javafx/23.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.proyectofinal.RecuperarController"
            stylesheets="@Recuperar.css">
    
    <ImageView fitHeight="600.0" fitWidth="800.0" preserveRatio="false">
        <image>
            <Image url="@../../../RECURSOS/fondo.png" />
        </image>
        <effect>
            <GaussianBlur radius="8.0" />
        </effect>
    </ImageView>
    
    <StackPane alignment="CENTER" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" 
               AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <VBox alignment="CENTER" prefHeight="622.0" prefWidth="821.0" 
              spacing="20" id="recoveryContainer">
            <ImageView fitHeight="130.0" fitWidth="131.0" preserveRatio="true">
                <image>
                    <Image url="@../../../RECURSOS/dinomuseo.PNG" />
                </image>
            </ImageView>
            
            <Label id="recoveryTitle" text="Recuperar Contraseña"/>
            
            <VBox alignment="CENTER" spacing="15">
                <Label id="instructionLabel" text="Ingrese su correo electrónico:"/>
                <TextField fx:id="txtCorreo" prefHeight="41.0" prefWidth="723.0" />
                <Label id="instructionLabel" text="su nueva contraseña es " />
            </VBox>
            <Label id="newPassword" text="Aqui nueva Contraseña" />
            
            <VBox alignment="CENTER" spacing="10">
                <Button prefHeight="40.0" prefWidth="200.0" id="recoveryButton" text="Recuperar" />
                <Button onAction="#volverLogin" id="transparentButton" text="Volver al Login" />
            </VBox>
        </VBox>
    </StackPane>
</AnchorPane>