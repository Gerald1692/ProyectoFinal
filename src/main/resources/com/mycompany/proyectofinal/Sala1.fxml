[file content begin]
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="600" prefWidth="800.0" stylesheets="@Sala1.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyectofinal.Controllers.Sala1Controller">
    
    <top>
        <HBox alignment="CENTER" styleClass="header">
            <Label styleClass="headerTitle" text="Velociraptor">
                <font>
                    <Font name="Bodoni MT Bold" size="48.0" />
                </font>
            </Label>
        </HBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER">
            <HBox alignment="TOP_CENTER" spacing="40" style="-fx-padding: 30;">
                <VBox alignment="CENTER" styleClass="imageContainer">
                    <ImageView fitHeight="341" fitWidth="319" preserveRatio="true" styleClass="objectImage">
                        <image>
                            <Image url="@../../../RECURSOS/Velociraptor.png" />
                        </image>
                    </ImageView>
                </VBox>
                
                <VBox alignment="TOP_LEFT" prefWidth="400" spacing="20" styleClass="infoContainer">
                    <Label styleClass="sectionTitle" text="EL CAZADOR ÁGIL" />
                    
                    <Text styleClass="descriptionText" text="El Velociraptor fue un dinosaurio terópodo dromeosáurido que vivió durante el período Cretácico superior, hace aproximadamente 75 a 71 millones de años, en lo que hoy es Asia. A diferencia de su representación en el cine, el Velociraptor era de tamaño pequeño, con una longitud de alrededor de 2 metros y una altura de 0.5 metros, y un peso estimado de 15 a 20 kilogramos. Su nombre significa 'ladrón veloz'." wrappingWidth="400" />
                    
                    <Text styleClass="descriptionText" text="El primer espécimen de Velociraptor fue descubierto en el Desierto de Gobi, Mongolia, en 1923 durante una expedición del Museo Americano de Historia Natural. El hallazgo más famoso es el de un Velociraptor luchando con un Protoceratops, conocido como el 'fósil de lucha', que muestra a ambos dinosaurios muertos durante el combate. El Velociraptor tenía un cuerpo ligero y ágil, con una garra en forma de hoz en cada pie que usaba para atacar a sus presas. Además, se cree que estaba cubierto de plumas, similar a las aves modernas, como lo indican las impresiones de folículos de plumas encontradas en algunos fósiles." wrappingWidth="400" />
                    
                    <Separator styleClass="separator" />
                    
                    <VBox spacing="10" style="-fx-padding: 10 0;">
                        <Label styleClass="infoLabel" text="Ubicación:" />
                        <Label styleClass="infoValue" text="Sala 1 - Gigantes del Jurásico" />
                        
                        <Label styleClass="infoLabel" text="Estado:" />
                        <Label styleClass="infoStatus" text="En exhibición" />
                    </VBox>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
    
    <bottom>
        <HBox alignment="CENTER" spacing="20" styleClass="footer">
            <Button onAction="#volverLogin" styleClass="navButton" text="Volver al Inicio de Sesión" />
            <Button onAction="#irSalaPrincipal" styleClass="navButton" text="Volver a Sala" />
        </HBox>
    </bottom>
</BorderPane>
[file content end]